# Необязательно: заполни и `source config.env` ПЕРЕД запуском install.sh,
# чтобы не вводить руками. Пустые значения скрипт спросит интерактивно.

export DOMAIN="так-совпало.рф"          # можно кириллицей или сразу xn--…
export LE_EMAIL="you@example.com"
export PANEL_USER="admin"                 # логин панели 3x-ui
export PANEL_PASS=""                      # пусто = сгенерировать
export AMNEZIA_PASS=""                    # пусто = сгенерировать
export N_CLIENTS="1"                      # сколько подписок создать сразу
# export CLIENT_NAMES="ya,Sanya,Giga"     # имена клиентов (иначе user1..userN)

# Редко меняется:
# export XUI_VERSION="v2.8.10"            # версия 3x-ui (под неё проверена схема БД)
# export FORCE="1"                        # не спрашивать подтверждение при несовпадении DNS
# export SOVPALO_REPO="https://github.com/vikluxjs/PMS"
# export SOVPALO_BRANCH="main"
